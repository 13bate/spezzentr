@use '../../shared/styles/variables.scss' as *;

// ─── Section ─────────────────────────────────────────────────
.giftCards {
  margin: 100px 0;
  background: $color-bg-light-footer;
  position: relative;
  overflow: hidden;

  @media (max-width: 768px) {
    padding: 40px 0 56px;
  }
}

.container {

  @media (max-width: 768px) {
    padding: 0 16px;
  }
}

// ─── Header Row ──────────────────────────────────────────────
.headerRow {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: center;
  margin-bottom: 64px;

  @media (max-width: 1024px) {
    grid-template-columns: 1fr;
    gap: 32px;
    margin-bottom: 48px;
  }
}

// ─── Content ──────────────────────────────────────────────────
.content {
  display: flex;
  flex-direction: column;
  gap: 16px;

  @media (max-width: 1024px) {
    order: 2;
    text-align: center;
  }
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: $color-brand-primary;
  background: $color-glass-primary-alpha;
  padding: 4px 16px;
  border-radius: 999px;
  border: 1px solid $color-border-primary-alpha;
  width: fit-content;

  @media (max-width: 1024px) {
    align-self: center;
  }

  &::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    background: $color-brand-primary;
    border-radius: 50%;
  }
}

.title {
  font-family: 'Oswald', 'Inter', sans-serif;
  font-size: clamp(32px, 4vw, 48px);
  font-weight: 700;
  color: $color-text-dark-main;
  line-height: 1.05;
  letter-spacing: -0.02em;
  margin: 0;

  span {
    color: $color-brand-primary;
  }

  @media (max-width: 768px) {
    font-size: clamp(28px, 6vw, 36px);
  }
}

.description {
  font-size: 16px;
  line-height: 1.7;
  color: $color-text-dark-muted;
  max-width: 500px;

  @media (max-width: 1024px) {
    max-width: 100%;
  }

  @media (max-width: 768px) {
    font-size: 14px;
  }
}

.buttonGroup {
  display: flex;
  gap: 12px;
  margin-top: 4px;
  flex-wrap: wrap;

  @media (max-width: 1024px) {
    justify-content: center;
  }

  @media (max-width: 480px) {
    flex-direction: column;
    width: 100%;
  }
}

.primaryBtn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 14px 28px;
  background: $color-brand-primary;
  color: #fff;
  border: none;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.25s ease;
  box-shadow: 0 4px 20px $color-shadow-primary-deep;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  white-space: nowrap;

  &:hover {
    background: $color-brand-primary-hover;
    transform: translateY(-2px);
    box-shadow: 0 8px 32px $color-shadow-primary-deep;
  }

  svg {
    transition: transform 0.25s ease;
  }

  &:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 480px) {
    width: 100%;
    justify-content: center;
    padding: 14px 20px;
  }
}

.secondaryBtn {
  display: inline-flex;
  align-items: center;
  padding: 14px 28px;
  background: transparent;
  color: $color-text-dark-main;
  border: 1.5px solid $color-border-dark-alpha;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.25s ease;
  text-transform: uppercase;
  letter-spacing: 0.04em;

  &:hover {
    border-color: $color-brand-primary;
    color: $color-brand-primary;
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  }

  @media (max-width: 480px) {
    width: 100%;
    justify-content: center;
  }
}

// ─── Media Container ─────────────────────────────────────────
.mediaContainer {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;

  @media (max-width: 1024px) {
    order: 1;
  }
}

// ─── Premium Gift Card ──────────────────────────────────────
.card {
  position: relative;
  width: 100%;
  max-width: 440px;
  aspect-ratio: 1.618 / 1;
  border-radius: 18px;
  overflow: hidden;
  background: linear-gradient(145deg, #1a1b1e, #0d0e10);
  box-shadow: 
    0 20px 60px rgba(0, 0, 0, 0.3),
    0 2px 8px rgba(0, 0, 0, 0.1),
    inset 0 1px 0 rgba(255, 255, 255, 0.06);

  @media (max-width: 768px) {
    max-width: 100%;
    border-radius: 14px;
  }
}

.cardBg {
  position: absolute;
  inset: 0;
  background: 
    radial-gradient(ellipse at 30% 20%, rgba(179, 32, 37, 0.12) 0%, transparent 60%),
    radial-gradient(ellipse at 70% 80%, rgba(179, 32, 37, 0.06) 0%, transparent 50%);
  z-index: 0;
}

.cardStripe {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(90deg, 
    $color-brand-primary 0%, 
    $color-brand-primary 40%, 
    rgba(255, 255, 255, 0.15) 40%, 
    rgba(255, 255, 255, 0.15) 60%,
    $color-brand-primary 60%, 
    $color-brand-primary 100%
  );
  z-index: 2;
  opacity: 0.6;
}

.cardContent {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 100%;
  padding: 24px 28px;

  @media (max-width: 768px) {
    padding: 18px 20px;
  }
}

.cardHeader {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.cardBrand {
  font-family: 'Oswald', 'Inter', sans-serif;
  font-size: 20px;
  font-weight: 700;
  color: #fff;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  opacity: 0.9;

  @media (max-width: 768px) {
    font-size: 16px;
  }
}

.cardType {
  font-size: 10px;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.4);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  padding: 3px 10px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 4px;

  @media (max-width: 768px) {
    font-size: 8px;
    padding: 2px 8px;
  }
}

.cardValue {
  display: flex;
  align-items: baseline;
  gap: 4px;
  margin: 12px 0;
}

.amount {
  font-family: 'Oswald', 'Inter', sans-serif;
  font-size: clamp(32px, 5vw, 52px);
  font-weight: 700;
  color: #fff;
  letter-spacing: -0.02em;
}

.currency {
  font-family: 'Inter', sans-serif;
  font-size: clamp(18px, 2vw, 24px);
  font-weight: 500;
  color: rgba(255, 255, 255, 0.5);
}

.cardFooter {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
  padding-top: 14px;
}

.cardNumber {
  font-family: 'Inter', monospace;
  font-size: 14px;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.3);
  letter-spacing: 0.06em;

  @media (max-width: 768px) {
    font-size: 11px;
  }
}

.cardExpiry {
  font-family: 'Inter', monospace;
  font-size: 11px;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.2);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.gloss {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0.02) 40%, transparent 100%);
  pointer-events: none;
  z-index: 2;
}

.cornerDecor {
  position: absolute;
  top: 16px;
  right: 16px;
  width: 24px;
  height: 24px;
  z-index: 2;
  opacity: 0.3;
}

// ─── Section Title ──────────────────────────────────────────
.sectionTitle {
  font-family: 'Oswald', 'Inter', sans-serif;
  font-size: clamp(24px, 2.5vw, 32px);
  font-weight: 700;
  color: $color-text-dark-main;
  letter-spacing: -0.02em;
  margin: 0 0 28px 0;
  text-align: center;

  @media (max-width: 768px) {
    font-size: clamp(20px, 4vw, 26px);
    margin-bottom: 20px;
  }
}

// ─── Benefits ─────────────────────────────────────────────────
.benefits {
  margin-bottom: 64px;

  @media (max-width: 768px) {
    margin-bottom: 40px;
  }
}

.benefitsGrid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;

  @media (max-width: 1024px) {
    grid-template-columns: repeat(2, 1fr);
  }

  @media (max-width: 480px) {
    grid-template-columns: 1fr;
  }
}

.benefitItem {
  padding: 24px;
  background: $color-bg-light-card;
  border-radius: $radius-card-medium;
  border: 1px solid $color-border-dark-alpha;
  transition: all 0.3s ease;

  &:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
  }

  h4 {
    font-size: 15px;
    font-weight: 700;
    color: $color-text-dark-main;
    margin: 0 0 6px 0;
  }

  p {
    font-size: 13px;
    line-height: 1.5;
    color: $color-text-dark-muted;
    margin: 0;
  }
}

.benefitIcon {
  font-size: 18px;
  color: $color-brand-primary;
  display: block;
  margin-bottom: 10px;
}

// ─── Pricing ──────────────────────────────────────────────────
.pricing {
  margin-bottom: 64px;

  @media (max-width: 768px) {
    margin-bottom: 40px;
  }
}

.pricingGrid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;

  @media (max-width: 1024px) {
    grid-template-columns: repeat(2, 1fr);
  }

  @media (max-width: 480px) {
    grid-template-columns: 1fr;
  }
}

.planCard {
  display: flex;
  flex-direction: column;
  gap: 10px;
  position: relative;
  padding: 24px 20px;
  background: $color-bg-light-card;
  border-radius: $radius-card-medium;
  border: 1px solid $color-border-dark-alpha;
  text-align: center;
  transition: all 0.3s ease;

  &:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  h4 {
    font-size: 14px;
    font-weight: 600;
    color: $color-text-dark-muted;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 8px 0;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 16px 0 20px;
    text-align: left;

    li {
      font-size: 13px;
      color: $color-text-dark-muted;
      padding: 4px 0;
      padding-left: 20px;
      position: relative;
      line-height: 1.4;

      &::before {
        content: '✓';
        position: absolute;
        left: 0;
        color: $color-brand-primary;
        font-weight: 700;
      }
    }
  }
}

.price {
  font-family: 'Oswald', 'Inter', sans-serif;
  font-size: 28px;
  font-weight: 700;
  color: $color-text-dark-main;
  letter-spacing: -0.02em;

  @media (max-width: 768px) {
    font-size: 24px;
  }
}

.popular {
  border-color: $color-brand-primary;
  box-shadow: 0 4px 20px $color-shadow-primary-light;

  &:hover {
    box-shadow: 0 8px 32px $color-shadow-primary-light;
  }
}

.popularBadge {
  position: absolute;
  top: -10px;
  left: 50%;
  transform: translateX(-50%);
  background: $color-brand-primary;
  color: #fff;
  font-size: 10px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  padding: 2px 14px;
  border-radius: 999px;
}

.planBtn {
  display: inline-block;
  padding: 10px 32px;
  background: $color-glass-dark-alpha;
  color: $color-text-dark-main;
  border: 1px solid $color-border-dark-alpha;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.25s ease;

  &:hover {
    border-color: $color-brand-primary;
    color: $color-brand-primary;
  }

  &.primary {
    background: $color-brand-primary;
    color: #fff;
    border: none;
    box-shadow: 0 4px 16px $color-shadow-primary-deep;

    &:hover {
      background: $color-brand-primary-hover;
      color: #fff;
      transform: translateY(-2px);
    }
  }
}

// ─── How It Works ────────────────────────────────────────────
.howItWorks {
  margin-bottom: 64px;

  @media (max-width: 768px) {
    margin-bottom: 40px;
  }
}

.steps {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
  margin-bottom: 32px;

  @media (max-width: 1024px) {
    grid-template-columns: repeat(2, 1fr);
  }

  @media (max-width: 480px) {
    grid-template-columns: 1fr;
  }
}

.step {
  text-align: center;

  h4 {
    font-size: 16px;
    font-weight: 700;
    color: $color-text-dark-main;
    margin: 0 0 4px 0;
  }

  p {
    font-size: 13px;
    color: $color-text-dark-muted;
    margin: 0;
    line-height: 1.4;
  }
}

.stepNumber {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: $color-glass-primary-alpha;
  color: $color-brand-primary;
  font-family: 'Oswald', 'Inter', sans-serif;
  font-size: 18px;
  font-weight: 700;
  margin-bottom: 10px;
}

.electronicInfo {
  max-width: 600px;
  margin: 0 auto;
  padding: 24px 28px;
  background: $color-bg-light-card;
  border-radius: $radius-card-medium;
  border: 1px solid $color-border-dark-alpha;
  text-align: center;

  strong {
    display: block;
    font-size: 16px;
    font-weight: 700;
    color: $color-text-dark-main;
    margin-bottom: 4px;
  }

  p {
    font-size: 14px;
    color: $color-text-dark-muted;
    margin: 0;
    line-height: 1.5;
  }
}

// ─── Features ─────────────────────────────────────────────────
.features {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
  padding-top: 48px;
  border-top: 1px solid $color-border-dark-alpha;

  @media (max-width: 1024px) {
    grid-template-columns: repeat(2, 1fr);
    padding-top: 32px;
  }

  @media (max-width: 480px) {
    grid-template-columns: 1fr;
    padding-top: 24px;
  }
}

.featureItem {
  h4 {
    font-size: 14px;
    font-weight: 700;
    color: $color-text-dark-main;
    margin: 0 0 4px 0;
  }

  p {
    font-size: 13px;
    color: $color-text-dark-muted;
    margin: 0;
    line-height: 1.4;
  }
}

.featureIcon {
  font-size: 20px;
  display: block;
  margin-bottom: 8px;
}

// ─── Dark Theme ──────────────────────────────────────────────
.dark {
  .giftCards {
    background: $color-bg-dark-section-1;
  }

  .title {
    color: $color-text-light-main;

    span {
      color: $color-brand-primary;
    }
  }

  .description {
    color: $color-text-light-muted;
  }

  .badge {
    background: rgba(179, 32, 37, 0.15);
    border-color: rgba(179, 32, 37, 0.3);
  }

  .secondaryBtn {
    color: $color-text-light-main;
    border-color: rgba(255, 255, 255, 0.1);

    &:hover {
      border-color: $color-brand-primary;
      color: $color-brand-primary;
    }
  }

  .sectionTitle {
    color: $color-text-light-main;
  }

  .benefitItem {
    background: $color-bg-dark-card-from;
    border-color: rgba(255, 255, 255, 0.06);

    h4 {
      color: $color-text-light-main;
    }

    p {
      color: $color-text-light-muted;
    }
  }

  .planCard {
    background: $color-bg-dark-card-from;
    border-color: rgba(255, 255, 255, 0.06);

    h4 {
      color: $color-text-light-muted;
    }

    .price {
      color: $color-text-light-main;
    }

    ul li {
      color: $color-text-light-muted;
    }
  }

  .planBtn {
    color: $color-text-light-main;
    border-color: rgba(255, 255, 255, 0.1);

    &:hover {
      border-color: $color-brand-primary;
      color: $color-brand-primary;
    }

    &.primary {
      color: #fff;
      border: none;
    }
  }

  .popular {
    border-color: $color-brand-primary;
  }

  .step {
    h4 {
      color: $color-text-light-main;
    }

    p {
      color: $color-text-light-muted;
    }
  }

  .electronicInfo {
    background: $color-bg-dark-card-from;
    border-color: rgba(255, 255, 255, 0.06);

    strong {
      color: $color-text-light-main;
    }

    p {
      color: $color-text-light-muted;
    }
  }

  .featureItem {
    h4 {
      color: $color-text-light-main;
    }

    p {
      color: $color-text-light-muted;
    }
  }

  .features {
    border-top-color: rgba(255, 255, 255, 0.06);
  }
}
